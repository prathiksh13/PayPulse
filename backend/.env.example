# Razorpay (Test Mode) — https://dashboard.razorpay.com/app/keys (use test keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
# Webhook secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Supabase Auth (Project Settings -> API)
# URL like https://xxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public anon key - safe to expose to the frontend
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key - NEVER expose to the frontend. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Demo merchant used for the shared demo data (leave default for the demo).
DEMO_MERCHANT_ID=demo_merchant_001

# Optional: override gateway base (default https://api.razorpay.com/v1)
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Supabase PostgreSQL connection string (pooler/replica).
# Comment this out to run locally on SQLite (backend/pulseops.db).
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# Groq — powers the AI payment operations agent (llama-3.3-70b-versatile).
# If omitted the agent runs in deterministic (no-LLM) mode using real DB stats.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000